# Production settings for the free Render + TiDB Cloud setup (see docs/DEPLOYMENT.md).
# This is a template: no real values. On Render these are environment variables
# (render.yaml lists them); never commit a file with real credentials.
#
# To test the TiDB connection from your own computer, copy this file to .env.tidb (git-ignored),
# fill in the database values, point MYSQL_ATTR_SSL_CA at the downloaded certificate, and run:
#   php artisan db:show --env=tidb

APP_NAME="Sira AI"
APP_ENV=production
APP_DEBUG=false
# Generate with `php artisan key:generate --show`. Never reuse the development key.
APP_KEY=
APP_URL=https://sira-api.onrender.com
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# TiDB Cloud Starter (MySQL-compatible). The username includes the cluster prefix, e.g. xxxxxxxx.root
DB_CONNECTION=mysql
# From TiDB Cloud: your cluster > Connect > Connect With: .env
DB_HOST=
DB_PORT=4000
DB_DATABASE=sira_ai
DB_USERNAME=
DB_PASSWORD=
# TLS is required. On Render the system bundle already contains TiDB's CA (ISRG Root X1).
# Locally on Windows, use the downloaded file instead, e.g. C:/path/to/sira-ai-productivity-be/storage/certs/isrgrootx1.pem
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Render's free tier has no workers or persistent disk.
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database
SIRA_AVATAR_STORAGE=database
# Sent as the X-Cron-Secret header by the cron service calling /api/v1/cron/run.
SIRA_CRON_SECRET=

CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,https://sira-ai-0kb.pages.dev
SANCTUM_TOKEN_EXPIRATION_MINUTES=86400

# Password reset emails (e.g. Brevo's free SMTP relay).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Off until their accounts exist: coach answers "not configured", purchases are app-store only.
SIRA_AI_DRIVER=anthropic
ANTHROPIC_API_KEY=
SIRA_BILLING_DRIVER=revenuecat
SIRA_PUSH_DRIVER=log
