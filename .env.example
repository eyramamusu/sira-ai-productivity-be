APP_NAME="Sira AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sira
DB_USERNAME=sira
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mobile apps send Bearer tokens; these origins may call the API from a browser/WebView.
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost,http://localhost:4200
SANCTUM_TOKEN_EXPIRATION_MINUTES=86400

SIRA_PASSWORD_RESET_URL=http://localhost:4200/reset-password
SIRA_FREE_MAX_HABITS=3
SIRA_FREE_MAX_GOALS=3
SIRA_PRODUCT_MONTHLY=sira_premium_monthly
SIRA_PRODUCT_ANNUAL=sira_premium_annual

# Billing: revenuecat | store | fake (local/testing only)
SIRA_BILLING_DRIVER=fake
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT=premium
REVENUECAT_WEBHOOK_AUTH=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.sira.productivity
GOOGLE_PLAY_RTDN_TOKEN=
APPLE_BUNDLE_ID=com.sira.productivity
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_ENVIRONMENT=sandbox

# AI coach: anthropic | fake (local/testing only)
SIRA_AI_DRIVER=fake
ANTHROPIC_API_KEY=
SIRA_AI_MODEL=claude-opus-5-5
SIRA_AI_EFFORT=medium
SIRA_AI_DAILY_LIMIT=50
